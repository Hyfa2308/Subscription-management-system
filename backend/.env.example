# ─── Application ───────────────────────────────────────────────────────────
APP_NAME=REVORA
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# ─── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite (local dev) – leave DATABASE_URL empty to use SQLite automatically
DATABASE_URL=
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/revora

SQLITE_PATH=./revora_dev.db

# ─── Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Odoo Integration (optional) ───────────────────────────────────────────
ODOO_ENABLED=false
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
